# Maintainer: ApiPlant <releases@apiplant.com>
pkgname=kale-tts
pkgver=@VERSION@
pkgrel=1
pkgdesc="Native Rust text-to-speech using Kale models"
arch=('x86_64')
url="https://github.com/apiplant/kale-tts-rs"
license=('MIT' 'Apache-2.0')
depends=('glibc')
source=("kale-tts-$pkgver-x86_64.tar.gz::https://github.com/apiplant/kale-tts-rs/releases/download/v$pkgver/kale-tts-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA_LINUX_X86_64@')
options=('!strip' '!debug')

package() {
  install -Dm755 "$srcdir/kale-tts" "$pkgdir/usr/bin/kale-tts"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/kale-tts/README.md"
  for file in LICENSE LICENSE-KaleComputer LICENSE-Kokoro-Candle THIRD_PARTY_NOTICES.md; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/kale-tts/$file"
  done
}
