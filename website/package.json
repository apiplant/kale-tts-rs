{
  "name": "kale-tts-rs-website",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Local speech synthesis with Kale Nano, Tiny, and Base in Rust.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name kale-tts-rs-website --branch main"
  },
  "dependencies": {
    "@solidjs/web": "2.0.4",
    "solid-js": "2.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@solidjs/babel-plugin": "2.0.3",
    "@solidjs/vite-plugin": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@10.28.2"
}
